<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/w_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Heute"
                android:textColor="#FAFAFA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A1A1AA"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Aktualisieren"
            android:padding="8dp"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/w_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Neue Aufgabe"
            android:padding="8dp"
            android:src="@drawable/ic_add_dark" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="16dp"
        android:text="Alles erledigt."
        android:textColor="#A1A1AA"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/w_row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/w_check0"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Erledigen"
            android:padding="7dp"
            android:src="@drawable/ic_circle" />

        <TextView
            android:id="@+id/w_title0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:textColor="#FAFAFA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_due0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A1A1AA"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/w_check1"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Erledigen"
            android:padding="7dp"
            android:src="@drawable/ic_circle" />

        <TextView
            android:id="@+id/w_title1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:textColor="#FAFAFA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_due1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A1A1AA"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/w_check2"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Erledigen"
            android:padding="7dp"
            android:src="@drawable/ic_circle" />

        <TextView
            android:id="@+id/w_title2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:textColor="#FAFAFA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_due2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A1A1AA"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/w_check3"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Erledigen"
            android:padding="7dp"
            android:src="@drawable/ic_circle" />

        <TextView
            android:id="@+id/w_title3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:textColor="#FAFAFA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_due3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A1A1AA"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/w_check4"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Erledigen"
            android:padding="7dp"
            android:src="@drawable/ic_circle" />

        <TextView
            android:id="@+id/w_title4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:textColor="#FAFAFA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_due4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A1A1AA"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
