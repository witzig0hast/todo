# Kopieren nach .env und anpassen.

# Nur-lokaler Port, auf den nginx weiterleitet
TODO_PORT=8080

# Cookies nur über HTTPS senden (mit nginx+TLS immer true). Nur für Tests ohne TLS: false
COOKIE_SECURE=true

# Ollama (läuft auf dem Host)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
# Bild-Modell (Foto -> Aufgaben) und Embedding-Modell (Suche nach Bedeutung); pro Benutzer änderbar
#OLLAMA_VISION_MODEL=qwen2.5vl:7b
#OLLAMA_EMBED_MODEL=bge-m3

# Whisper (wyoming-whisper, TCP-Port 10300 auf dem Host)
WHISPER_HOST=host.docker.internal
WHISPER_PORT=10300
WHISPER_LANGUAGE=de

# Absender-Kontakt für Web-Push (VAPID)
VAPID_SUBJECT=mailto:du@example.com

# ---------------------------------------------------------------- Single Sign-On (OpenID Connect), optional
# Öffentliche Adresse der App (für die Redirect-URI). Pflicht, sobald SSO aktiv ist.
#PUBLIC_URL=https://todo.example.com

# --- Ein Anbieter (z. B. Authentik): Issuer = Application > Provider > "OpenID Configuration Issuer"
#OIDC_ID=authentik
#OIDC_NAME=Authentik
#OIDC_ISSUER=https://auth.example.com/application/o/todo/
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES=openid profile email
# Mitglieder dieser Gruppen werden Admin (kommagetrennt, nur Hochstufung)
#OIDC_ADMIN_GROUPS=todo-admins
# Neue SSO-Benutzer sofort freigeben (false = wie bei der Registrierung: Admin muss freigeben)
#OIDC_AUTO_APPROVE=false

# --- Mehrere Anbieter statt der Kurzform oben (JSON-Liste in einer Zeile):
#OIDC_PROVIDERS=[{"id":"authentik","name":"Authentik","issuer":"https://auth.example.com/application/o/todo/","client_id":"…","client_secret":"…","admin_groups":["todo-admins"]},{"id":"google","name":"Google","issuer":"https://accounts.google.com","client_id":"…","client_secret":"…"}]

# Anmeldung/Registrierung mit Passwort abschalten (nur wirksam, wenn SSO konfiguriert ist)
#LOCAL_AUTH_ENABLED=true

# ---------------------------------------------------------------- Betrieb
# Anzahl täglicher Backups in /data/backups, die behalten werden
#BACKUP_KEEP=14
# Passkeys: PUBLIC_URL (oben) muss die echte HTTPS-Adresse sein – davon hängt die Passkey-Domain ab.
